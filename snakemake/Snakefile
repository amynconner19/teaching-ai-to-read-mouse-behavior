from pathlib import Path

configfile: "config/config.yaml"

VIDEO_NAMES = (Path(config["input"]) / "videos").glob("*.avi")
VIDEO_NAMES = [v.stem for v in VIDEO_NAMES]

# The inputs to 'all' determine what outputs are generated by the workflow
rule all:
    input: 
        expand(
            f"{config['output']}/{{video_name}}DLC_DlcrnetStride32Ms5_BIOMAPMar17shuffle1_snapshot_best-200.csv",
            video_name=VIDEO_NAMES
        )

# This rule runs everything up to the GUI step
rule run_preprocessing:
    input:
        expand(
            f"{config['output']}/{{video_name}}.csv",
            video_name=VIDEO_NAMES
        )

rule copy_base_project:
    input:
        base=config["base_project"]
    output:
        config=f"{config['input']}/config.yaml",
        dlc_models=directory(f"{config['input']}/dlc-models"),
        dlc_models_pytorch=directory(
            f"{config['input']}/dlc-models-pytorch"
        ),
        evaluation=directory(
            f"{config['input']}/evaluation-results-pytorch"
        ),
        labeled_data=directory(
            f"{config['input']}/labeled-data"
        ),
        training_datasets=directory(
            f"{config['input']}/training-datasets"
        )
    params:
        input=f"{config['input']}"
    shell:
        """
        mkdir -p {params.input}
        cp -R {input.base}/. {params.input}/
        """

rule analyze_videos:
    input:
        video=f"{config['input']}/videos/{{video_name}}.avi",
        config=f"{config['input']}/config.yaml",
    output:
        face_csv=f"{config['output']}/{{video_name}}DLC_DlcrnetStride32Ms5_BIOMAPMar17shuffle1_snapshot_best-200.csv",
    params:
        output=config["output"]
    conda:
        "envs/DEEPLABCUT.yaml"
    shell:
        """
        python <<'EOF'
import deeplabcut

deeplabcut.add_new_videos(
    "{input.config}",
    videos=["{input.video}"],
    copy_videos=False
)

deeplabcut.analyze_videos(
    config="{input.config}",
    videos=["{input.video}"],
    videotype=".avi",
    save_as_csv=True,
    destfolder="{params.output}",
)
EOF
        """

rule update_csv:
    input:
        face_csv=f"{config['output']}/{{video_name}}DLC_DlcrnetStride32Ms5_BIOMAPMar17shuffle1_snapshot_best-200.csv"
    output:
        output_csv=f"{config['output']}/{{video_name}}.csv"
    conda:
        "envs/DEEPLABCUT.yaml"
    shell:
        """
        python <<'EOF'
# Update {input.face_csv} and with step 3 in issue #15 and output to {output.csv} 
EOF
        """

##################################################
### DO PROCESSING WITH GUI AND RERUN SNAKEMAKE ###
##################################################

rule extract_features:
    input:
        updated_csv=f"{config['output']}/{{video_name}}.csv",
        config=f"{config['input']}/config.yaml",
    output:
        features_csv=f"{config['output']}/csv/features_extracted/{{video_name}}.csv"
    params:
        output_dir=f"{config['output']}/csv/features_extracted"
    conda:
        "simba"
    shell:
        """
        mkdir -p {params.output_dir}
        python <<'EOF'
# Use Simba to extract features from {input.updated_csv} and output to {output.features_csv} using {input.config} as the config file
EOF
        """

rule add_columns:
    input:
        features_csv=f"{config['output']}/csv/features_extracted/{{video_name}}.csv",
        config=f"{config['input']}/config.yaml",
    output:
        updated_features_csv=f"{config['output']}/csv/features_extracted/{{video_name}}_updated.csv"
    conda:
        "simba"
    shell:
        """
        mkdir -p {params.output_dir}
        python <<'EOF'
# Use Simba/Pandas to add columns to {input.features_csv} and save to {output.updated_features_csv}
EOF
        """

rule run_simba:
    input:
        updated_features_csv=f"{config['output']}/csv/features_extracted/{{video_name}}_updated.csv"
        config=f"{config['input']}/config.yaml", # THIS PROBABLY NEEDS CHANGED
    output:
        simba_csv=f"{config['output']}/csv/simba/{{video_name}}.csv"
    params:
        output_dir=f"{config['output']}/csv/simba"
    conda:
        "simba"
    shell:
        """
        mkdir -p {params.output_dir}
        python <<'EOF'
# Run simba on {input.updated_features_csv} and {input.config} and output to {output.simba_csv}.
EOF
        """

rule create_graphs:
    input:
        simba_csv=f"{config['output']}/csv/simba/{{video_name}}.csv"
    output:
        figure_directory=directory(f"{config['output']}/figures")
    conda:
        "simba"
    shell:
        """
        mkdir -p {output.figure_directory}
        python <<'EOF'
# Create graphs from {input.simba_csv} and output them all into {output.figure_directory}
EOF
        """

